    "stale_rtt_after_seconds": 15,
    "unreachable_after_consecutive_supported_failures": 3,
    "valid_rtt_window_samples": 12,
    "idle_transport": "serverinfo-service-response; paired-pinned-https-for-apps-and-bandwidth",
    "icmp_required": false,
    "icmp_fallback": "optional-unprivileged-ipv4-ipv6-echo-1.5s"
  },
  "bandwidth": {
