{
  "schema_version": 2,
  "status": "specification-only-not-runtime",
  "enabled": true,
  "refresh_interval_seconds": 5,
  "monitor_scope": "visible-configured-hosts-and-active-stream-host",
  "background_policy": "cancel-and-pause",
  "lightweight_probes": {
    "maximum_global_in_flight": 2,
    "maximum_per_host_in_flight": 1,
    "timeout_seconds": 2,
    "stale_rtt_after_seconds": 15,
    "unreachable_after_consecutive_supported_failures": 3,
    "valid_rtt_window_samples": 12,
    "idle_transport": "paired-pinned-https-serverinfo-where-supported",
    "icmp_required": false
  },
  "bandwidth": {
    "primary_direction": "host-to-client",
    "rolling_goodput_window_seconds": 5,
    "distinguish_goodput_from_available_capacity": true,
    "saturating_test_every_refresh": false,
    "capacity_test": "pre-session-or-explicit-user-request-supported-host-endpoint",
    "maximum_capacity_test_seconds_per_direction": 8,
    "maximum_capacity_test_bytes_per_direction": 134217728,
    "maximum_lightweight_probe_bytes_per_interval_global": 131072,
    "available_capacity_stale_after_seconds": 30,
    "missing_supported_endpoint": "show-unknown; no-fabricated-capacity",
    "require_same_route_udp_validation_for_auto": true,
    "maximum_capacity_request_seconds": 2,
    "apply_twenty_percent_headroom_once": true,
    "vibeshine_adapter": {
      "reference_commit": "0689b2e021d6106612a7ed72a34dacc714b7a133",
      "endpoint": "/pyrowave-bandwidth-probe",
      "method": "GET",
      "requires_pairing_and_pinned_https": true,
      "payload_bytes_per_request": 33554432,
      "warmup_requests": 1,
      "measured_requests": 3,
      "selection": "slowest-completed-transfer",
      "server_maximum_requests_per_client_per_minute": 8,
      "honor_http_429": true,
      "direction": "host-to-client",
      "udp_quality_guaranteed": false
    }
  },
  "measurement_identity": [
    "host",
    "endpoint",
    "address_family",
    "client_interface_route",
    "direction",
    "transport"
  ],
  "separate_collection_and_measurement_time": true,
  "invalidate_on_route_change": true,
  "live_degradation_windows_before_policy_action": 3,
  "switch_codec_each_refresh": false
}
