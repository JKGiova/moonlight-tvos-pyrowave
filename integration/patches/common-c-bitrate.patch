+static int selectAutomaticBitrate(void) {
+    if (NegotiatedVideoFormat & VIDEO_FORMAT_MASK_PYROWAVE) {
+        // Vibeshine recommends about 1.6 bits per pixel for PyroWave 8-bit 4:2:0.
+        // Divide pixels per second by 625 to obtain kilobits per second.
+        int64_t targetKbps = (int64_t)StreamConfig.width * StreamConfig.height * StreamConfig.fps / 625;
+        if (targetKbps < 500) {
+            return 500;
+        }
+        return targetKbps > 500000 ? 500000 : (int)targetKbps;
+    }
+
+    // Match Moonlight's standard recommendations for the tvOS stream resolutions.
+    int64_t pixels = (int64_t)StreamConfig.width * StreamConfig.height;
+    int mbpsAt30Fps;
+    if (pixels >= 3840 * 2160) {
+        mbpsAt30Fps = 40;
+    }
+    else if (pixels >= 2560 * 1440) {
+        mbpsAt30Fps = 20;
+    }
+    else if (pixels >= 1920 * 1080) {
+        mbpsAt30Fps = 10;
+    }
+    else {
+        mbpsAt30Fps = 5;
+    }
+    return mbpsAt30Fps * 1000 * (StreamConfig.fps > 60 ? 60 : StreamConfig.fps) / 30;
 }
 
