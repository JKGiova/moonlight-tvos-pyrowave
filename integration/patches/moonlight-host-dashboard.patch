+            !owner->_dashboardVisible || owner->_dashboardPairing || owner->_dashboardLaunching) return;
+        owner->_hostMonitor = [[MLHostNetworkMonitor alloc] initWithHost:host update:^(MLHostNetworkSnapshot *snapshot, ServerInfoResponse *info, AppListResponse *apps) {
+            MainFrameViewController *controller = weakSelf;
+            if (!controller || epoch != controller->_dashboardEpoch || host != controller->_selectedHost || controller->_dashboardLaunching) return;
+            BOOL stateChanged = controller->_dashboardState != snapshot.state;
+            controller->_dashboardState = snapshot.state;
+            BOOL ready = snapshot.state == MLHostDashboardReady;
+            if (ready && info) {
+                [info populateHost:host];
